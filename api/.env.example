# Copy to .env and edit. Everything here has a working default except the paths.

DATABASE_URL=postgresql://ragdemo:ragdemo@localhost:5444/ragdemo

# The answer model. Authentication follows the Claude Code CLI: either
# ANTHROPIC_API_KEY, or the credentials the CLI is already logged in with.
ANSWER_MODEL=claude-opus-5
EXPAND_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Salts the per-caller hash in ask_log. Change it per deployment; the log stores
# a hash rather than an address, and a shared salt makes those comparable across
# deployments, which is the thing it exists to prevent.
ASK_IP_SALT=change-me-per-deployment

# bge-m3 has to be installed for this to do anything. Off means corpora asking
# for hybrid retrieval run lexical-only, which the trace says plainly.
EMBED_ENABLED=false

# --- who may administer this -------------------------------------------------
# Reading (questions, search, traces) is open. Administering - corpora,
# documents, sources, settings - is trusted from localhost and needs this key
# from anywhere else. With no key set there is no remote administration at all.
API_KEY=

# Turn off on a shared machine, where "localhost" is not only you.
TRUST_LOCALHOST=true

# DANGEROUS, and off by default. Sources of kind `filesystem`, and MCP servers
# over stdio, let this process read host files and run host commands - so with
# this on, admin access is command execution as the user running the server.
# Fine for a single-user local install. Never on a shared or exposed host.
ALLOW_LOCAL_EXEC=false

# Off by default so a source cannot be pointed at your internal network or at a
# cloud metadata endpoint. Turn on to reach an MCP server on localhost.
ALLOW_PRIVATE_NETWORK=false

# The MCP server this app exposes to Claude Desktop, Cursor and the like.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8143

# --- optional corpora --------------------------------------------------------
# Both skip cleanly when unset, and `./ingest.sh` then builds only the two AI Act
# corpora, which need nothing but an internet connection.
#
# A SQLite database of video transcripts (see ingest/pipeline.py for the shape).
VIDEO_DB=
VIDEO_TOPICS=AI Automation & Agents,Voice Agents
VIDEO_CAP=300
# Directories of markdown, comma-separated.
DOC_ROOTS=
